{
  "manifest_version": 3,
  "name": "Focus Finder",
  "version": "1.0",
  "description": "Double-tap Shift to open a palette that finds and focuses any input, button or link on the page. Fully keyboard accessible.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shortcut.js", "focus.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Focus Finder",
    "default_popup": "settings.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
